CC ?= gcc
TARGET := primer
SOURCES := primer.c utils.c
OBJECTS := $(SOURCES:.c=.o)

CPPFLAGS ?= -I.
CFLAGS ?= -O2 -Wall -Wextra
LDLIBS := -lglut -lGLU -lGL -lm

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(LDLIBS)

%.o: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

primer.o: utils.h
utils.o: utils.h

clean:
	rm -f $(OBJECTS) primer
